{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>canoypa/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CI で lockfile を確かめる gh-actions-lock を最新に保つ",
      // github-actions マネージャは、workflow の env に書いた拡張の版を見ない
      "managerFilePatterns": [".github/workflows/ci.yaml"],
      "matchStrings": ["GH_ACTIONS_LOCK_VERSION:\\s*(?<currentValue>v\\S+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "patch と digest の更新を、手でマージせずに取り込む",
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "patch and digest updates",
      // main の ruleset で CI の ci-ok を必須にしているので、CI が通ったものだけがマージされる
      "automerge": true
    },
    {
      "description": "npm の minor の更新で、手で見る PR を少なくする",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm minor dependencies"
    },
    {
      "description": "zenn-cli と textlint を、major の更新も手でマージせずに最新に保つ",
      "matchManagers": ["npm"],
      // textlint は CI の pnpm lint で動くのを確かめられる。
      // 名前で並べる。textlint-* だと、あとから足した textlint- で始まるパッケージも、誰が出したものでも major まで自動マージされる
      "matchPackageNames": [
        "zenn-cli",
        "textlint",
        "textlint-filter-rule-allowlist",
        "textlint-filter-rule-comments",
        "textlint-rule-preset-ja-spacing",
        "textlint-rule-preset-ja-technical-writing"
      ],
      "automerge": true
    }
  ]
}
