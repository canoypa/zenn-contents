{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>canoypa/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "github-actions マネージャが見ない gh-actions-lock 拡張のバージョンを追跡する",
      "managerFilePatterns": [".github/workflows/ci.yaml"],
      "matchStrings": ["GH_ACTIONS_LOCK_VERSION:\\s*(?<currentValue>v\\S+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "パッチ・SHA ダイジェスト更新をまとめて自動マージする。main の ruleset で CI の ci-ok を必須にしている",
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "patch and digest updates",
      "automerge": true
    },
    {
      "description": "npm の minor 更新をまとめる",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm minor dependencies"
    }
  ]
}
